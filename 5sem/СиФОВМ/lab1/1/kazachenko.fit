	OH7R0P12 : LORAX = "G63R0,PA33R0C1";
	OH1R0P5 : LORAX = "G44R0,PA19R0C1";
	OH8R0P13 : LORAX = "G0R0,PA6R0C1";
	LC20    : LORAX = "G16R0,PA1R0C1";
