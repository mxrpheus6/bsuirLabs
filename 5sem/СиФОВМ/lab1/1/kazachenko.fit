CHIP "kazachenko"
BEGIN

    DEVICE = "EPM7032LC44-6";

    "c0"                           : INPUT_PIN  = 4      ; -- LC1
    "c1"                           : INPUT_PIN  = 16     ; -- LC11
    "c2"                           : INPUT_PIN  = 14     ; -- LC10
    "c3"                           : INPUT_PIN  = 13     ; -- LC9
    "c4"                           : INPUT_PIN  = 12     ; -- LC8
    "c5"                           : INPUT_PIN  = 11     ; -- LC7
    "c6"                           : INPUT_PIN  = 9      ; -- LC6
    "c7"                           : INPUT_PIN  = 8      ; -- LC5
    "x1"                           : INPUT_PIN  = 7      ; -- LC4
    "x2"                           : INPUT_PIN  = 6      ; -- LC3
    "x3"                           : INPUT_PIN  = 5      ; -- LC2
    "y"                            : OUTPUT_PIN = 41     ; -- LC17
    "|XOR8:35|:49"                 : LOCATION   = LC19   ; -- PIN 39
    "|XOR8:35|:52"                 : LOCATION   = LC20   ; -- PIN 38
    "|XOR8:35|:53"                 : LOCATION   = LC21   ; -- PIN 37

END;

INTERNAL_INFO "kazachenko"
BEGIN
	DEVICE = EPM7032LC44-6;
	LC17    : LORAX = "G13R0";
	LC21    : LORAX = "G30R0,PA16R0C1";
	OH3R0P7 : LORAX = "G46R0,PA24R0C1";
